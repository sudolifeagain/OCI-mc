DISCORD_TOKEN=your_discord_bot_token
NOTION_TOKEN=your_notion_integration_token
NOTION_DB_ID=your_notion_database_id
NOTION_DS_ID=optional_data_source_id_override
DISCORD_CHANNEL_ID=your_discord_channel_id_for_notifications
DISCORD_ADMIN_ID=admin_role_id
DISCORD_MOD_ID=mod_role_id
DISCORD_OWNER_ID=owner_user_id
DISCORD_USER_ID=user_role_id
DISCORD_USER_IDS=user_role_id
DISCORD_CLAUDE_ROLE_ID=claude_role_id
# カンマ区切り。管理コマンドは指定guild/channel内だけで実行可能。
DISCORD_GUILD_IDS=discord_guild_id
DISCORD_COMMAND_CHANNEL_IDS=management_channel_id
# 任意OSコマンドを許可するDiscordユーザーIDとチャンネル。
DISCORD_SHELL_USER_IDS=owner_user_id
DISCORD_SHELL_CHANNEL_IDS=management_channel_id
DISCORD_STATUS_CHANNEL_ID=status_channel_id
DISCORD_PAPER_LOG_CHANNEL_ID=paper_log_channel_id
DISCORD_FORGE_LOG_CHANNEL_ID=forge_log_channel_id
DISCORD_FORGE_ALT_LOG_CHANNEL_ID=forge_alt_log_channel_id
PAPER_RCON_PASSWORD=replace_with_a_random_password
FORGE_RCON_PASSWORD=replace_with_a_random_password
FORGE_ALT_RCON_PASSWORD=replace_with_a_random_password
# 本番既定値: /opt/minecraft/.bot-runtime
SERVER_RUNTIME_DIR=/opt/minecraft/.bot-runtime
