{
	"servers": {
		"paper": {
			"name": "Paper",
			"jar": "paper.jar",
			"java_command": "/usr/lib/jvm/java-25-openjdk-arm64/bin/java",
			"cwd": "/opt/minecraft/paper",
			"memory": "4G",
			"port": 25565,
			"auto_start": false,
			"run_as_user": "mc-paper",
			"startup_timeout": 180,
			"log_queue_size": 1000,
			"rcon_port": 25575,
			"rcon_password_env": "PAPER_RCON_PASSWORD"
		},
		"forge": {
			"name": "Forge",
			"use_script": "./run.sh",
			"cwd": "/opt/minecraft/forge",
			"port": 25566,
			"auto_start": false,
			"run_as_user": "mc-forge",
			"startup_timeout": 600,
			"log_queue_size": 1000,
			"log_forwarding": false,
			"rcon_port": 25576,
			"rcon_password_env": "FORGE_RCON_PASSWORD"
		},
		"forge-alt": {
			"name": "Forge (Alt)",
			"use_script": "./run.sh",
			"cwd": "/opt/minecraft/forge-alt",
			"port": 25567,
			"auto_start": false,
			"run_as_user": "mc-forge-alt",
			"startup_timeout": 600,
			"log_queue_size": 1000,
			"log_forwarding": false,
			"rcon_port": 25577,
			"rcon_password_env": "FORGE_ALT_RCON_PASSWORD"
		}
	},
	"default_server": "paper",
	"permissions": {
		"start": [
			"admin",
			"mod"
		],
		"stop": [
			"admin"
		],
		"restart": [
			"admin",
			"mod"
		],
		"rcon": [
			"admin"
		],
		"backup": [
			"admin"
		],
		"whitelist_add": [
			"admin",
			"mod",
			"user"
		],
		"status": [
			"admin",
			"mod",
			"user"
		],
		"claude": [
			"claude_user"
		],
		"reaction_role_setup": [
			"admin"
		]
	},
	"backup": {
		"target_dirs": {
			"paper": [
				"world"
			],
			"forge": [
				"world"
			],
			"forge-alt": [
				"world"
			]
		},
		"schedule_time": "04:00"
	},
	"reaction_roles": {
		"channel_id": 1448157321590079572,
		"mappings": {
			"\u2705": {
				"channel_id": 1485199249053454367,
				"label": "開発チャンネル"
			}
		}
	},
	"plugins": {
		"paper": {
			"geyser": {
				"source": "geysermc",
				"project": "geyser",
				"platform": "spigot",
				"filename": "Geyser-Spigot.jar"
			},
			"floodgate": {
				"source": "geysermc",
				"project": "floodgate",
				"platform": "spigot",
				"filename": "floodgate-spigot.jar"
			},
			"bluemap": {
				"source": "github",
				"repo": "BlueMap-Minecraft/BlueMap",
				"asset_pattern": "bluemap-*-paper.jar",
				"release_tag": "v5.22",
				"filename_pattern": "bluemap-*-paper.jar"
			},
			"worldedit": {
				"source": "modrinth",
				"project": "worldedit",
				"loader": "paper",
				"game_version": "26.2",
				"version_number": "7.4.4",
				"filename_pattern": "worldedit-bukkit-*.jar"
			},
			"expbottleboost": {
				"source": "github",
				"repo": "sudolifeagain/ExpBottleBoost",
				"asset_pattern": "ExpBottleBoost-*.jar",
				"filename_pattern": "ExpBottleBoost-*.jar"
			}
		}
	}
}
