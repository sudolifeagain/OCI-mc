{
	"servers": {
		"paper": {
			"name": "Paper (Vanilla)",
			"jar": "paper.jar",
			"cwd": "/opt/minecraft/paper",
			"memory": "4G",
			"port": 25565
		},
		"forge": {
			"name": "Forge (Better MC)",
			"use_script": "./run.sh",
			"cwd": "/opt/minecraft/forge",
			"memory": "10G",
			"port": 25566
		}
	},
	"default_server": "paper",
	"roles": {
		"admin": null,
		"mod": null,
		"owner": null
	},
	"permissions": {
		"start": [
			"admin",
			"mod"
		],
		"stop": [
			"admin"
		],
		"restart": [
			"admin",
			"mod"
		],
		"command": [
			"admin"
		],
		"backup": [
			"admin"
		],
		"whitelist_add": [
			"admin",
			"mod",
			"user"
		],
		"status": [
			"admin",
			"mod",
			"user"
		]
	},
	"backup": {
		"target_dirs": {
			"paper": [
				"world",
				"world_nether",
				"world_the_end"
			],
			"forge": [
				"world"
			]
		},
		"schedule_time": "04:00"
	},
	"plugins": {
		"paper": {
			"geyser": {
				"source": "geysermc",
				"project": "geyser",
				"platform": "spigot",
				"filename": "Geyser-Spigot.jar"
			},
			"floodgate": {
				"source": "geysermc",
				"project": "floodgate",
				"platform": "spigot",
				"filename": "floodgate-spigot.jar"
			},
			"bluemap": {
				"source": "github",
				"repo": "BlueMap-Minecraft/BlueMap",
				"asset_pattern": "bluemap-*-paper.jar",
				"filename": "bluemap-paper.jar"
			}
		}
	}
}